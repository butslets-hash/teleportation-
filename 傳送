-- ========== FUNÇÕES AUXILIARES ==========
local function playSound(id, vol)
	if not gui then return end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = vol or 0.5
	s.Parent = gui
	s:Play()
	Debris:AddItem(s, 6)
end

local function tween(obj, time, props, style, dir)
	local info = TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

local function hover(btn, normal, over)
	btn.MouseEnter:Connect(function()
		playSound(SND.hover, 0.15)
		tween(btn, 0.15, { BackgroundTransparency = over })
	end)
	btn.MouseLeave:Connect(function()
		tween(btn, 0.15, { BackgroundTransparency = normal })
	end)
end

local function makeButton(text, parentFrame, order)
	local b = Instance.new("TextButton")
	b.LayoutOrder = order
	b.Size = UDim2.new(1, 0, 0, 32)
	b.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	b.BackgroundTransparency = 0.82
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Font = Enum.Font.GothamSemibold
	b.Text = text
	b.TextColor3 = TEXT
	b.TextSize = 14
	local s = Instance.new("UIStroke")
	s.Color = ACCENT
	s.Transparency = 0.5
	s.Thickness = 1
	s.Parent = b
	b.Parent = parentFrame
	hover(b, 0.82, 0.62)
	return b
end

local function fill(tpl, map)
	return (tpl:gsub("{{(%w+)}}", function(k) return map[k] end))
end

-- Sistema de tradução
local function onLang(fn)
	table.insert(refresh, fn)
end

local function refreshTitle()
	if current and titleLbl then
		titleLbl.Text = T[lang][pageTitle[current]]
	end
end

local function applyLang()
	local d = T[lang]
	for _, fn in ipairs(refresh) do
		fn(d)
	end
	refreshTitle()
end

