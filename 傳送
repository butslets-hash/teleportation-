-- ========== TROCA DE PÁGINA ==========
local function goPage(to)
	if transitioning or to == current then return end
	transitioning = true

	local prev = current
	current = to
	if prev then
		local ps = pageScale[prev]
		local t = tween(ps, 0.2, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		t.Completed:Wait()
		prev.Visible = false
	end

	to.Visible = true
	pageScale[to].Scale = 0
	tween(pageScale[to], 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	refreshTitle()

	transitioning = false
end

