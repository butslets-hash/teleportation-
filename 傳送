local function explosion(center)
	playSound(SND.boom, 0.8)

	local flash = Instance.new("Frame")
	flash.AnchorPoint = Vector2.new(0.5, 0.5)
	flash.Position = center
	flash.Size = UDim2.fromOffset(0, 0)
	flash.BackgroundColor3 = Color3.fromRGB(255, 240, 200)
	flash.BackgroundTransparency = 0.1
	flash.BorderSizePixel = 0
	flash.ZIndex = 11
	flash.Parent = gui
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(1, 0)
	fc.Parent = flash
	tween(flash, 0.5, { Size = UDim2.fromOffset(420, 420), BackgroundTransparency = 1 })
	Debris:AddItem(flash, 0.7)

	local count = 14
	for i = 1, count do
		local p = Instance.new("Frame")
		p.AnchorPoint = Vector2.new(0.5, 0.5)
		p.Position = center
		p.Size = UDim2.fromOffset(8, 8)
		p.BackgroundColor3 = Color3.fromHSV(math.random(), 0.3, 1)
		p.BorderSizePixel = 0
		p.ZIndex = 12
		p.Parent = gui

		local angle = (i / count) * math.pi * 2
		local dist = math.random(120, 220)
		tween(p, 0.6, {
			Position = center + UDim2.fromOffset(math.cos(angle) * dist, math.sin(angle) * dist),
			BackgroundTransparency = 1,
			Rotation = math.random(-360, 360),
		})
		Debris:AddItem(p, 0.7)
	end
end

local function playBlackHole()
	local center = main.Position
	playSound(SND.hole, 0.8)

	local hole = Instance.new("Frame")
	hole.AnchorPoint = Vector2.new(0.5, 0.5)
	hole.Position = center
	hole.Size = UDim2.fromOffset(0, 0)
	hole.BackgroundColor3 = Color3.new(0, 0, 0)
	hole.BorderSizePixel = 0
	hole.ZIndex = 10
	hole.Parent = gui

	local hc = Instance.new("UICorner")
	hc.CornerRadius = UDim.new(1, 0)
	hc.Parent = hole

	local glow = Instance.new("UIStroke")
	glow.Color = Color3.fromRGB(170, 90, 255)
	glow.Thickness = 3
	glow.Transparency = 0.2
	glow.Parent = hole

	local ring = Instance.new("Frame")
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = center
	ring.Size = UDim2.fromOffset(170, 170)
	ring.BackgroundTransparency = 1
	ring.ZIndex = 11
	ring.Parent = gui

	local rc = Instance.new("UICorner")
	rc.CornerRadius = UDim.new(1, 0)
	rc.Parent = ring

	local rs = Instance.new("UIStroke")
	rs.Color = Color3.fromRGB(170, 90, 255)
	rs.Thickness = 2
	rs.Transparency = 0.6
	rs.Parent = ring

	local rScale = Instance.new("UIScale")
	rScale.Scale = 0
	rScale.Parent = ring

	local COLS = {
		Color3.fromRGB(190, 120, 255),
		Color3.fromRGB(255, 170, 90),
		Color3.fromRGB(120, 200, 255),
	}
	local COUNT = 16
	for i = 1, COUNT do
		local a = (i / COUNT) * math.pi * 2
		local sz = (i % 3 == 0) and 9 or 6
		local dot = Instance.new("Frame")
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.Size = UDim2.fromOffset(sz, sz)
		dot.Position = UDim2.fromOffset(85 + math.cos(a) * 80, 85 + math.sin(a) * 80)
		dot.BackgroundColor3 = COLS[(i % #COLS) + 1]
		dot.BorderSizePixel = 0
		dot.ZIndex = 11
		dot.Parent = ring

		local dc = Instance.new("UICorner")
		dc.CornerRadius = UDim.new(1, 0)
		dc.Parent = dot
	end

	tween(rScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	local spin = TweenService:Create(
		ring,
		TweenInfo.new(1.2, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1),
		{ Rotation = 360 }
	)
	spin:Play()

	tween(hole, 0.5, { Size = UDim2.fromOffset(140, 140) }, Enum.EasingStyle.Back)
	tween(scale, 0.8, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(main, 0.8, { Rotation = 720 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

	task.wait(0.8)
	main.Visible = false

	spin:Cancel()
	local collapse = tween(hole, 0.3, { Size = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(rScale, 0.3, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	collapse.Completed:Wait()
	hole:Destroy()
	ring:Destroy()

	explosion(center)

	main.Rotation = 0
	scale.Scale = 0
	main.Visible = true
	tween(scale, 0.6, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

-- ========== AÇÕES ==========
local function generate()
	local d = T[lang]
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		playSound(SND.error, 0.6)
		setStatus("stNoChar", true)
		return
	end

	local label = nameBox.Text:match("^%s*(.-)%s*$")
	if label == "" then label = d.dest end

	local p = hrp.Position
	generated = fill(TEMPLATE, {
		X = string.format("%.3f", p.X),
		Y = string.format("%.3f", p.Y),
		Z = string.format("%.3f", p.Z),
		NOME = string.format("%q", label),
		TPTITLE = d.tpTitle,
		TPBTN = d.tpBtn,
	})

	setStatus("stReady", false)
	copyBtn.TextColor3 = TEXT
	playSound(SND.success, 0.6)
end

local function copyScript()
	if busy then return end
	if not generated then
		playSound(SND.error, 0.6)
		setStatus("stNoGen", true)
		return
	end

	busy = true
	local ok = false
	if setclipboard then
		ok = pcall(setclipboard, generated)
	end

	if ok then
		playSound(SND.copy, 0.7)
		setStatus("stCopied", false)
	else
		print(generated)
		setStatus("stNoClip", true)
	end

	playBlackHole()
	busy = false
end

